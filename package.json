{
  "name": "todo-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "start:web": "turbo run start --filter=todo-web",
    "dev": "turbo run dev",
    "dev:clean": "pnpm run clean && pnpm run build && pnpm run dev",
    "dev:web": "pnpm run build --filter=!todo-web && turbo run dev --filter=todo-web",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "check-all": "turbo lint check-types test build",
    "clean": "turbo clean",
    "clean:git": "find . -name \".git\" -type d -not -path \"./.git\" -exec rm -rf {} +",
    "commit": "cz",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.1.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.6",
    "next": "^15.3.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.5.1",
    "turbo": "^2.6.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.9"
  },
  "packageManager": "pnpm@9.0.0",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": "9.0.0"
  }
}
